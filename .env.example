# Copie este arquivo para ".env" na raiz e ajuste os valores conforme o ambiente.
# Nunca comitar o arquivo ".env" real.

# ---- PostgreSQL (usado pelo docker-compose.yml e pelo backend) ----
# POSTGRES_PORT é a porta exposta no HOST (a porta interna do container
# continua 5432). Usamos 5433 por padrão porque é comum já existir um
# PostgreSQL nativo ocupando a porta 5432 na máquina do desenvolvedor —
# nesse caso localhost:5432 cairia no Postgres nativo, não no container.
POSTGRES_USER=credito_user
POSTGRES_PASSWORD=credito_pass
POSTGRES_DB=cadastro_credito
POSTGRES_PORT=5433

# ---- Backend (NestJS / Prisma) ----
# String de conexão consumida pelo Prisma. Deve refletir as variáveis acima.
DATABASE_URL="postgresql://credito_user:credito_pass@localhost:5433/cadastro_credito?schema=public"

# Porta em que a API NestJS sobe localmente
PORT=3000

# Origem permitida pelo CORS do backend (deve casar com a porta do Vite)
CORS_ORIGIN=http://localhost:5173

# ---- Autenticacao (JWT) ----
# Gere valores proprios por ambiente, ex.: `openssl rand -hex 32`.
# Nunca reutilizar os valores deste exemplo em producao.
JWT_ACCESS_SECRET=troque-este-valor-em-cada-ambiente
JWT_REFRESH_SECRET=troque-este-outro-valor-em-cada-ambiente
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Frontend (Vite) ----
# URL base da API consumida pelo frontend em desenvolvimento
VITE_API_URL=http://localhost:3000
